# Copy to .env (gitignored). devenv loads it. Defaults shown; see docs/architecture.md.
# ENTRY_POINTS=public=0.0.0.0:80/http,internal=127.0.0.1:8081/http,secure=0.0.0.0:443/https  # replaces PROXY_ADDR and PROXY_TLS_ADDR; setting both is an error
# ENTRY_POINTS="secure=0.0.0.0:443/https;http3"  # ;http3[=port] also serves HTTP/3 on that UDP port (https only); quote it, `;` ends a shell word
# H3_MAX_CONNECTIONS=10000
# H3_MAX_HANDSHAKES=256
# H3_RETRY=on_load  # always, on_load or never
# H3_UDP_RECV_BUFFER=2097152
# H3_MAX_STREAMS=100
# H3_CONNECTION_WINDOW=262144
# PROXY_ADDR=127.0.0.1:8080
# PROXY_TLS_ADDR=127.0.0.1:8443
# ADMIN_SOCKET=/run/podgate/admin.sock
# REQUEST_TIMEOUT_SECS=30
# LOG_FORMAT=pretty
# NODE_NAME=node-1
# ACME_CA_FILE=/etc/podgate/acme-root.pem
# ACME_DNS_ZONES=<comma-separated zones apps may use the dns-01 challenge for; unset: off>
# RUST_LOG=info
# WASM_MAX_CONCURRENT=<available cores, at most 256>
# WASM_QUEUE_TIMEOUT_MS=1000
# BASIC_AUTH_MAX_CONCURRENT=<available cores, at most 256>
# HEALTH_MAX_CONCURRENT=64
# CATCH_ALL_TENANTS=<comma-separated tenant ids allowed catch-all routers>
# UPSTREAM_POLICY_FILE=/etc/podgate/upstream-policy.json
# ACCESS_LOG_FILE=/var/log/podgate/access.log
# METRICS_ADDR=127.0.0.1:9100  # read-only GET /metrics over TCP for Prometheus; unset: only the admin socket serves it
# METRICS_SERIES_PER_TENANT=500
# DASHBOARD_ADDR=127.0.0.1:9200  # read-only web UI over the overview and explain APIs; unset: no dashboard. A non-loopback address needs DASHBOARD_AUTH_FILE
# DASHBOARD_AUTH_FILE=/etc/podgate/dashboard.htpasswd  # user:hash lines, bcrypt or argon2
# DASHBOARD_HOSTS=dash.example  # extra Host header names the dashboard answers to, such as when it is reached through podgate
# TLS_MIN_VERSION=1.2
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<key>
# OTEL_EXPORTER_OTLP_CERTIFICATE=/etc/podgate/otel-ca.pem
# OTEL_SERVICE_NAME=podgate
# OTEL_MAX_SPANS_PER_SEC=1000
# STATIC_ROOTS_FILE=/etc/podgate/static-roots.json  # {"<tenant id>": {"<root name>": "/srv/static/<tenant>/<name>"}}
# RATE_LIMIT_STORES_FILE=/etc/podgate/limit-stores.json  # {"<store>": {"url": "rediss://host:6379", "password_file": "...", "tls_ca_file": "...", "tenants": ["<tenant id>"]}}
# STATIC_MAX_CONCURRENT_READS=<available cores times 4, at most 256>
# UPSTREAM_POOL_SIZE=128  # idle upstream connections per worker thread (one per core)
# DNS_SERVERS=10.0.0.2,[fd00::2]:5353  # name servers for upstream host names; unset: the system resolver configuration
# DNS_MIN_TTL_SECS=1
# DNS_MAX_TTL_SECS=60
# DNS_TIMEOUT_MS=2000
# DNS_MAX_STALE_SECS=300
# DNS_MAX_QUERIES_PER_SEC=200
