# Copy to .env (gitignored). devenv loads it. Defaults shown; see docs/architecture.md.
# ENTRY_POINTS=public=0.0.0.0:80/http,internal=127.0.0.1:8081/http,secure=0.0.0.0:443/https  # replaces PROXY_ADDR and PROXY_TLS_ADDR; setting both is an error
# PROXY_ADDR=127.0.0.1:8080
# PROXY_TLS_ADDR=127.0.0.1:8443
# ADMIN_SOCKET=/run/podgate/admin.sock
# REQUEST_TIMEOUT_SECS=30
# LOG_FORMAT=pretty
# NODE_NAME=node-1
# ACME_CA_FILE=/etc/podgate/acme-root.pem
# RUST_LOG=info
# WASM_MAX_CONCURRENT=<available cores, at most 256>
# WASM_QUEUE_TIMEOUT_MS=1000
# CATCH_ALL_TENANTS=<comma-separated tenant ids allowed catch-all routers>
# UPSTREAM_POLICY_FILE=/etc/podgate/upstream-policy.json
